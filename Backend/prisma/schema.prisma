generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int             @id @default(autoincrement())
  fullName              String
  email                 String          @unique
  password              String
  createdAt             DateTime        @default(now())
  otpExpiry             DateTime?
  lastOtpSentAt         DateTime?
  otpHash               String?
  otpRequestCount       Int             @default(0)
  otpRequestWindowStart DateTime?
  media                 Media[]
  posts                 Post[]
  refreshTokens         RefreshToken[]
  socialAccounts        SocialAccount[]
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  revoked   Boolean  @default(false)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model SocialAccount {
  id               Int       @id @default(autoincrement())
  provider         String
  providerId       String
  accessToken      String
  refreshToken     String?
  expiresAt        DateTime?
  platformUsername String?
  platformName     String?
  profilePic       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  userId           Int
  user             User      @relation(fields: [userId], references: [id])

  @@unique([provider, providerId])
  @@unique([userId, provider])
}

model Post {
  id              Int            @id @default(autoincrement())
  userId          Int
  content         String?
  contentMetadata Json?
  isScheduled     Boolean        @default(false)
  scheduledAt     DateTime?
  status          PostStatus     @default(DRAFT)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id])
  mediaItems      PostMedia[]
  platforms       PostPlatform[]
}

model PostMedia {
  id       Int   @id @default(autoincrement())
  postId   Int
  mediaId  Int
  position Int
  media    Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  post     Post  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, mediaId])
}

model PostPlatform {
  id           Int        @id @default(autoincrement())
  postId       Int
  platform     Platform
  status       PostStatus @default(PENDING)
  externalId   String?
  errorMessage String?
  editId       Int?
  publishedAt  DateTime?
  retryCount   Int        @default(0)
  MediaEdit    MediaEdit? @relation(fields: [editId], references: [id])
  post         Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Media {
  id          Int         @id @default(autoincrement())
  userId      Int
  fileUrl     String
  storagePath String
  mimeType    String
  type        MediaType
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id])
  MediaEdit   MediaEdit[]
  posts       PostMedia[]
}

model MediaEdit {
  id           Int            @id @default(autoincrement())
  mediaId      Int
  preset       String
  cropX        Float
  cropY        Float
  cropWidth    Float
  cropHeight   Float
  version      Int            @default(1)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  Media        Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  MediaVariant MediaVariant[]
  PostPlatform PostPlatform[]

  @@index([mediaId])
}

model MediaVariant {
  id          Int           @id @default(autoincrement())
  editId      Int
  storagePath String
  fileUrl     String
  status      VariantStatus @default(PENDING)
  version     Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  MediaEdit   MediaEdit     @relation(fields: [editId], references: [id], onDelete: Cascade)

  @@unique([editId, version])
}

enum PostStatus {
  DRAFT
  PENDING
  SCHEDULED
  PUBLISHED
  FAILED
  PARTIAL
  DISPATCHING
  QUEUED
  PUBLISHING
}

enum MediaType {
  IMAGE
  VIDEO
  REEL
  STORY
}

enum MediaStatus {
  UPLOADED
  DELETED
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  TWITTER
  THREADS
  YOUTUBE
  PINTEREST
  TIKTOK
}

enum VariantStatus {
  PENDING
  RENDERING
  READY
  FAILED
}
